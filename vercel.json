{
  "version": 2,
  "builds": [
    {
      "src": "backend/yolo_project/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "../backend/dist" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/yolo_project/wsgi.py"
    }
  ]
}